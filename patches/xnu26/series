# Device patch series for xnu-12377, one path per line in application order.
#
# Empty by design, and that is the honest state rather than an oversight.
#
# The sibling file patches/xnu/series holds 65 hunks hand-rebased onto
# xnu-8796 for the iOS 16 target. They are not reused here: the arm64e arch
# series against xnu-12377 already carries the machine layer, the 4 KiB work,
# the PAC keys and the offline-owner chain, so applying the old rebase on top
# would apply the same changes twice.
#
# Nothing myron-specific is known to be missing from the shared series yet, and
# a patch added here would be unverified. Add one only when a build fails on a
# gap that can be attributed to this board rather than to the arm64e series.
# See MIGRATION.md.

# The one SoC patch this board keeps, referenced from here rather than through a
# `soc:` prefix in board.toml. patch_series entries must each be a SERIES FILE;
# the driver reads every entry as a list of patch paths, so pointing patch_series
# at sheng-platform-power.patch directly makes it parse the patch body as a
# series and fail with "patch missing: .../sheng-platform-power.patch/diff --git
# a/bsd/kern/bsd_init.c". That is what CI reported on 2026-11-16.
#
# sheng-platform-power.patch only calls sheng_pmgr_run() under
# `#if defined(XNU_SHENG_PMGR) && XNU_SHENG_PMGR`, and this board sets
# CONFIG_XNU_SHENG_PMGR=n, so it compiles to nothing. It is listed so that
# turning that switch on later does not also require editing the patch order.
#
# native-smp-secondary.patch is deliberately absent: it edits board_config.h
# line 134, which the arm64e BCM2837 block moves, and its MAX_CPUS 8 /
# MAX_CPU_CLUSTERS 1 is older and less correct than that block's 8 / 2.
sheng-platform-power.patch

# sheng-platform-sleep.patch defines arm64_platform_sleep_hook in
# osfmk/arm64/cpu.c and calls it from ml_arm_sleep. ArmCpu.cpp declares it
# weak_import, which would normally allow the symbol to be absent, but on
# arm64e the authenticated pointer of an undefined weak symbol fails the link:
#   ld: symbol(s) not found for architecture arm64e
#     "_arm64_platform_sleep_hook", referenced from libArmCpu.a(ArmCpu.o)
# The component is in [kernel] archives, so the definition has to exist even
# though the hook stays NULL and nothing about sleep changes unless the kernel
# is booted with platform-sleep=1. Every call site in the patch tests for NULL,
# so a board that never sets that boot argument behaves as it did before.
#
# Taken from UniXNU-sheng's device series, where it is the last entry. The
# iokit hunk was written against a tree at 2026-11-16 and applies on top of the
# arm64e series this board already resolves.
sheng-platform-sleep.patch
