# iOS 26.5.2 kernel configuration fragment.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
#
# Applied as the OS layer, after arch:configs/common.config and
# soc:configs/sm8550.config and before the device defconfig, which applies last.
#
# arch:configs/common.config for arm64e already sets the flags this OS needs and
# which the iOS 16 profile had to spell out or omit:
#   CONFIG_XNU_BUILD_ARCHIVES=y   CONFIG_XNU_SOURCE_CORECRYPTO14=y
#   CONFIG_XNU_SOURCE_PTHREAD=y   CONFIG_XNU_ARM_DT_PLATFORM=y
#   CONFIG_XNU_ARMCPU=y           CONFIG_XNU_NATIVE_ARCH_TIMER=y
#   CONFIG_XNU_NATIVE_PAN=y
# Do not repeat them here; this file is the OS layer only.

# The kernel link consumes the prelinked native drivers and the original kexts.
# Matches profiles/os/ipados-26.5.2-23F84/configs/ipados.config, which carries
# this single line and nothing else.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
