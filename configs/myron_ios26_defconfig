# myron / iOS 26.5.2 (23F84, XNU 12377, arm64e) kernel configuration.
# PENDING: not yet qualified against a 23F84 kernelcache. See MIGRATION.md.
#
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script: y and n are 1
# and 0, a quoted string or a number is passed through, {tree} is the build tree.
#
# Configuration fragments apply first in this order:
#   arch:configs/common.config  soc:configs/sm8550.config  os:configs/ios.config
# and this file is applied last, so a value set here replaces the inherited one.
# The merge CONCATENATES; it does not deduplicate, and parse_config takes the
# last value for a name. A switch repeated below therefore overrides a fragment
# on purpose, and the duplication in the generated .config is expected.
#
# NATIVE_PAC has no switch in the first place: pointer
# authentication comes in through patches/xnu-12377/native-pac-keys.patch and
# native-pac-arm64-user-jop.patch, which are unconditional. There is no switch.
# NATIVE_CS_HASH_CACHE does exist and defaults to 0. An earlier note in this
# file claimed it was gone; that was wrong, and the kernel link proved it: the
# driver log (package/BootLog.c, taken from sheng) references the counters the
# patch only emits when the switch is on -
#   cs_native4k_read_ticks, cs_native4k_hash_ticks, cs_native4k_record_ticks
# - and native-4k-signature-hash-cache.patch guards their definitions with
#   #if defined(XNU_NATIVE_CS_HASH_CACHE) && XNU_NATIVE_CS_HASH_CACHE
# scripts/build-xnu-4k-baseline.sh turns the config into
#   ubc_subr.o_CFLAGS_ADD=-DXNU_NATIVE_CS_HASH_CACHE=$XNU_NATIVE_CS_HASH_CACHE
# with 0 as the default, so the definitions were simply compiled out. Turning it
# on supplies them for real instead of stubbing counters that are meant to be
# measured.

# The crypto bootstrap mode. os:configs/ios.config sets "prelinked"; this board
# overrides it to "source", and that override is the reason the virtio block
# transport is off below.
#
# In prelinked mode build-xnu-4k-baseline.sh compiles osfmk/prng/prng_random.c
# with -UXNU_SOURCE_CORECRYPTO14, which removes the definitions of
# source_corecrypto14_original and source_corecrypto14_start_once.
# libkern/c++/OSKext.cpp keeps the same #if guard and is NOT built with the -U,
# so it still references both. The archives that would satisfy them are attached
# only under [ "$BOOTSTRAP" = 0 ], so the bootstrap pass - the first one, which
# has to write the compile records and kernel headers - links without them and
# dies before producing either artifact. The driver needs those two artifacts to
# tolerate a bootstrap failure, so the build stops there.
#
# "source" compiles prng_random.c without the -U: both symbols exist in every
# pass and the ordering trap is gone. This is what UniXNU-sheng uses on the same
# XNU tag and the same SoC family.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"

# DT handoff and diagnostics.
CONFIG_XNU_DT_PANIC_REGION=y

# Early boot progress on the screen. The board has no serial port, and every kernel
# boot so far has ended with the loader's own text still showing and nothing after
# it - which reads the same whether XNU never started, died before its console, or
# died in arm_vm_init.
#
# zzz-boot-progress.patch already supplies the machinery: boot_progress_stage() in
# osfmk/kern/boot_progress.h, markers around arm_init and arm_vm_init, and hooks in
# _cnputc and vcputc_options that route console output to it. This switch is the one
# build-xnu-4k-baseline.sh wires itself (XNU_BOOT_PROGRESS, line 86), so no device
# patch is needed and none is added.
#
# It carries three prerequisites (build-xnu-4k-baseline.sh line 91-97):
#   XNU_NATIVE_UFS=1          already set above
#   XNU_OWNER_ROOT_AUDIT=1    set here
#   XNU_SOURCE_CORECRYPTO14=1 set here
# The audit itself is allowed because XNU_SOURCE_STORAGE=1 is already on: line 298
# only rejects an audit without real owner-verified block crypto.
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_BOOT_PROGRESS=y

# Paint stage markers straight into the GOP framebuffer from start.s/arm_init.
# The bare-metal loader route has no UEFI GOP or display provider for boot-progress,
# so this is the only way to see how far XNU gets.
CONFIG_XNU_MYRON_EARLY=y
# Supplies the cs_native4k_* counters the vendored BootLog.c references; see the
# note above.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y

# iOS 26 binaries are linked with chained fixups; without this the prelinked
# kexts and user space images cannot be rebound. Present in sheng's iPadOS 26
# defconfig for the same profile.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y

# Storage. ShengUfs drives the SM8550-class UFS controller. On this target UFS is
# the only durable store: the OS and SystemOS windows and the Data region all
# live on it, and the root volume is the UFS OS window.
#
# The virtio block transport is off, and not because it is unwanted. The build
# script refuses NATIVE_VIRTIO_BLOCK unless NATIVE_AES is on, and refuses
# NATIVE_AES unless the bootstrap mode is "prelinked" - which cannot build this
# tree for the reason above. So the three switches are a single decision and this
# board takes the source-mode side of it. Nothing on the storage path depends on
# virtio: XNU_NATIVE_UFS has its own archive and consults neither switch.
#
# PENDING: if the virtio transport is ever needed, the fix belongs upstream -
# either attach the crypto archive in the bootstrap pass too, or guard OSKext's
# references with the same -U that the prng object gets.
# The signed root-policy tables are handed to the kernel through the userdata
# image rather than carried in the boot image. build-sheng-source-storage.py
# explains why in its own comment: a bring-up image can carry one policy,
# because the boot image has to stay under the 192 MiB fastboot limit and the
# second table does not fit yet. With this set, only the 544-byte signed header
# goes into the boot image and NativeUfs reads "<window>.vroot" from the root
# image, checking it against that header.
#
# The alternative - leaving it unset - makes the script read a full manifest.bin
# for each window, and those are local inputs of the userdata image that this
# repository does not ship. UniXNU-sheng ships only manifest.header.bin for its
# 26 profile and sets this switch only in its 27 and macOS configs, so its 26
# configuration cannot pass this step either; that is an upstream gap, not
# something to work around here.
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"

# ShengUfs is driven through the source storage adapter, which is what
# registers the UFS window bindings and the verified-root anchor.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_AES=n

# ShengUfs subclasses IOBlockStorageDevice, which is not part of XNU: it ships
# in the prelinked IOStorageFamily kext. build-sheng-source-storage.py compiles
# the class from Apple's published sources together with the driver, so this
# kernel carries one real implementation and registers no duplicate OSMetaClass.
#
# That replaces an earlier approach which kept the class out of the kernel and
# bound the inherited slots to absolute addresses in the prelinked kext instead
# (libStorageBindings.a, from scripts/prelink-storage-bindings.json, measured out
# of an iOS 16 kernelcache). Both cannot be present: with the source classes
# linked, the static bindings produced seventeen duplicate symbols - the class
# vtable, its metaclass and gMetaClass, and each inherited method. The bindings
# archive and that script are therefore gone, and UniXNU-sheng's 26 profile lists
# the same single source adapter.
#
# libVerifiedRoot.a still carries the board's verified-root crypto and the empty
# policy table, and is attached explicitly because no config flag pulls it onto
# the link line.
#
# PENDING: the prelinked storage ABI this now relies on has not been exercised on
# hardware. Treat a vtable-slot mismatch at first storage access as the expected
# failure on this path rather than a surprise.
CONFIG_XNU_NATIVE_UFS_ARCHIVE="{tree}/build/sheng-ufs/libShengUfs.a"
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/verified-root/libVerifiedRoot.a"

# Display. GopFramebuffer presents through the UEFI GOP framebuffer the
# uefi-myron firmware publishes, but its kernel-side provider is a late archive
# that no builder in this tree produces yet. Both stay off until that archive
# exists, so the kernel links headless. The iOS 26 iPadOS profiles on sheng turn
# these on with build-gop-legacy-display-27.py; that script does not exist here
# and inventing one is not part of this migration.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set

# soc:configs/sm8550.config sets CONFIG_XNU_NATIVE_ADRENO=y. That stack targets
# Adreno 740 on SM8550; myron has an Adreno 840 on SM8850 and has no qualified
# driver, so the native GPU path is off. The public dada port reaches SpringBoard
# with Metal through metal2vulkan and Turnip; nothing of that pipeline is in this
# repository, so this port starts without GPU.
#
# This is a deliberate override of the soc fragment, so it appears after it in
# the merge order and the duplicated name in .config is expected.
CONFIG_XNU_NATIVE_ADRENO=n

# Not a QEMU board. The ArmVirtPlatform expert would claim the platform.
# CONFIG_XNU_ARMVIRT_PLATFORM is not set

# RAM block storage is not used on this board; the root volume is the UFS OS
# window and persistence is the UFS Data region.
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set

# No board PMGR driver. The SM8850 has no Apple PMGR block; the ADT reports a
# virtual platform instead (vmm-present), which is what keeps AMFI from waiting
# on an ApplePMGRNub.
# CONFIG_XNU_SHENG_PMGR is not set

# AppleKeyStore state is selected as a component but has no switch here: the
# arm64e series compiles it unconditionally.
